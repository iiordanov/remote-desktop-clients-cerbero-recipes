From 218667418e3b888a8556a5a7ef1fae115ed5b327 Mon Sep 17 00:00:00 2001
From: Iordan Iordanov <iiordanov@gmail.com>
Date: Sun, 25 Jan 2026 15:26:40 -0500
Subject: [PATCH] Include correct endian header for apple

---
 src/cd-scsi.c         | 9 ++++++++-
 src/cd-usb-bulk-msd.c | 9 ++++++++-
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/src/cd-scsi.c b/src/cd-scsi.c
index 4c50ebf..56cad51 100644
--- a/src/cd-scsi.c
+++ b/src/cd-scsi.c
@@ -25,7 +25,14 @@
 #include "spice-common.h"
 #include "spice-util.h"
 #include "cd-scsi.h"
-#include "endian.h"
+#if defined(__APPLE__)
+#include <machine/endian.h>
+#elif defined(__linux__) || defined(__unix__)
+#include <endian.h>
+#else
+/* Other platforms or custom implementation */
+#include <sys/types.h> // sys/types.h is more portable
+#endif
 
 #ifdef USE_USBREDIR
 
diff --git a/src/cd-usb-bulk-msd.c b/src/cd-usb-bulk-msd.c
index 353094f..48b1848 100644
--- a/src/cd-usb-bulk-msd.c
+++ b/src/cd-usb-bulk-msd.c
@@ -26,7 +26,14 @@
 #include "spice-util.h"
 #include "cd-usb-bulk-msd.h"
 #include "cd-scsi.h"
-#include "endian.h"
+#if defined(__APPLE__)
+#include <machine/endian.h>
+#elif defined(__linux__) || defined(__unix__)
+#include <endian.h>
+#else
+/* Other platforms or custom implementation */
+#include <sys/types.h> // sys/types.h is more portable
+#endif
 
 #ifdef USE_USBREDIR
 
